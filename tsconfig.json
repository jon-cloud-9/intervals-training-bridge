{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    // exactOptionalPropertyTypes is deliberately off: @modelcontextprotocol/sdk
    // declares optional members as `T | undefined` rather than `?: T`, so the
    // Transport interface and StreamableHTTPServerTransport options do not
    // satisfy it. Enabling it would mean casting at every SDK boundary, which
    // hides more than it catches.

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
