{
  "name": "intervals-training-bridge",
  "version": "0.2.0",
  "private": false,
  "description": "MCP server bridging Claude Code to intervals.icu",
  "type": "module",
  "license": "MIT",
  "repository": "github:jon-cloud-9/intervals-training-bridge",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "intervals-training-bridge": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
