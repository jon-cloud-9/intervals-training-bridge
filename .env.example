# ── intervals.icu ─────────────────────────────────────────────────────────────
# Generate at intervals.icu → Settings → Developer Settings.
# Auth is HTTP basic with the literal username "API_KEY" and this as the password.
INTERVALS_API_KEY=

# Your numeric athlete ID. "0" resolves to the authenticated athlete and is the
# default if left blank — set it explicitly only if you need to be unambiguous.
INTERVALS_ATHLETE_ID=

# Override only for testing against a mock server.
INTERVALS_BASE_URL=

# Give up on an intervals.icu request after this many milliseconds. Default 10000.
INTERVALS_TIMEOUT_MS=

# ── HTTP transport ────────────────────────────────────────────────────────────
# Used when the server runs as a Claude custom connector.
PORT=
HOST=

# ── Public endpoint auth ──────────────────────────────────────────────────────
# REQUIRED in HTTP mode. Generate with:  openssl rand -hex 32
# The server refuses to start without it (minimum 32 characters) unless
# ALLOW_UNAUTHENTICATED=true. HTTP mode exposes the write tools, which reach a
# calendar that syncs to a physical watch.
MCP_AUTH_TOKEN=

# Set to "true" ONLY when bound to localhost for development.
# Never set this while a public tunnel is active.
ALLOW_UNAUTHENTICATED=

# Requests per minute per IP against /mcp. Defaults to 120.
RATE_LIMIT_PER_MINUTE=

# Comma-separated hostnames for DNS-rebinding protection. Set this to your
# tailnet hostname when binding to a non-localhost address — the SDK only
# enables that protection automatically for localhost binds.
ALLOWED_HOSTS=

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=
LOGS_PATH=

# ── Misc ──────────────────────────────────────────────────────────────────────
TIMEZONE=
